---
import { getCollection, render } from 'astro:content';
export async function getStaticPaths() {
  return (await getCollection('posts')).map(post => ({ params: { id: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
---
<!doctype html>
<html lang="zh-CN">
  <head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><title>{post.data.title}</title></head>
  <body><main><a href="/">← 返回首页</a><article><h1>{post.data.title}</h1><time datetime={post.data.date.toISOString()}>{post.data.date.toISOString().slice(0, 10)}</time><Content /></article></main></body>
</html>
<style>body { font-family: system-ui, sans-serif; line-height: 1.7; margin: 0; } main { max-width: 48rem; margin: 4rem auto; padding: 0 1.25rem; } time { color: #666; }</style>
