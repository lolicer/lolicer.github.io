---
import { PostPreview } from 'astro-pure/components/pages'
import { getBlogCollection, sortMDByDate } from 'astro-pure/server'
import PageLayout from '@/layouts/BaseLayout.astro'
import Section from '@/components/home/Section.astro'
const posts = sortMDByDate(await getBlogCollection()).slice(0, 10)
---
<PageLayout meta={{ title: '首页' }}>
  <main class='mx-auto flex w-full max-w-3xl flex-col gap-10 py-12'>
    <h1 class='text-3xl font-medium'>我的博客</h1>
    <Section title='最近文章'>
      <ul class='flex flex-col gap-y-2'>
        {posts.map((post) => <li><PostPreview {post} /></li>)}
      </ul>
      <a href='/blog' class='self-end'>查看全部文章 →</a>
    </Section>
  </main>
</PageLayout>
